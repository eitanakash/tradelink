# ── Database ────────────────────────────────────────────────────────────────
# Railway Postgres plugin sets this automatically when you attach it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-random-hex-string

# ── Server ───────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — leave this blank in Railway.
PORT=3000

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=https://travajos.com,https://admin.travajos.com

# Public URL of this API service (used in notification links, etc.).
APP_URL=https://api.travajos.com

# ── Redis ────────────────────────────────────────────────────────────────────
# Railway Redis plugin sets this automatically when you attach it.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@travajos.com

# ── File Storage (S3 / R2) ───────────────────────────────────────────────────
# Set STORAGE_PROVIDER=S3 for AWS S3 or Cloudflare R2 in production.
# Leave MINIO_* vars unset — they are for local dev only.
STORAGE_PROVIDER=S3

AWS_REGION=us-east-1
AWS_BUCKET_NAME=travajos-uploads
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=replace-with-secret-key

# If using Cloudflare R2, override the endpoint:
# AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
